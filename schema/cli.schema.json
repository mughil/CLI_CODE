{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cli-code/schema/cli.schema.json",
  "title": "CLI_CODE tool entry",
  "description": "One built, normalized CLI entry as emitted by scripts/build-data.mjs into data/clis.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "slug", "name", "summary", "description", "categories",
    "source", "dataQuality", "install"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1 },
    "categories": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
    "useCases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "platforms": {
      "type": "array",
      "items": { "enum": ["linux", "macos", "windows", "web", "cross-platform"] },
      "uniqueItems": true
    },
    "language": { "type": ["string", "null"] },
    "runtime": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "install": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "command"],
        "properties": {
          "method": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "label": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "command"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "repository": { "type": ["string", "null"], "format": "uri" },
    "documentation": { "type": ["string", "null"], "format": "uri" },
    "packageManagers": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9+-]+$" }, "uniqueItems": true },
    "difficulty": { "enum": ["beginner", "intermediate", "advanced", null] },
    "alternatives": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
    "source": { "enum": ["harness", "public"] },
    "dataQuality": { "enum": ["derived", "curated"] },
    "lastVerified": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
